{
  "name": "LLM cost recipes",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  // The demo pages are static HTML. GitHub's file view shows their SOURCE, so
  // the only way to actually see them from a browser is to serve them. A
  // Codespace forwards this port automatically and offers to open it.
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "demos", "onAutoForward": "openPreview" }
  },
  // Backgrounded: serving in the foreground would hold the terminal, and the
  // terminal is where the recipes are run.
  "postAttachCommand": "nohup python3 -m http.server 8000 --directory demos >/dev/null 2>&1 & echo '' && echo 'demos serving on port 8000 - see the Ports tab' && echo 'recipes:  python3 run_all.py --menu' && echo ''",

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
